# Copy this as .env on Render and fill in values

NODE_ENV=production
PORT=10000

# Replace with your actual production URLs
CLIENT_URL=https://your-app.vercel.app
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/streamlearn
JWT_SECRET=use_a_very_long_random_string_minimum_64_chars
REFRESH_TOKEN_SECRET=another_very_long_random_string_for_refresh
REDIS_URL=rediss://default:password@host.upstash.io:6380

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_secret

# Render free blocks SMTP. "console" prints OTP codes and reset links in the Render log instead.
EMAIL_DRIVER=console
# smtp mode (hosts that allow SMTP):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

# Render free has one process: run the video and notification workers inside the server.
INLINE_WORKERS=true
# Render free is slow: make only 480p and 720p. FFMPEG_PRESET=veryfast is a good trade-off there.
TRANSCODE_MAX_HEIGHT=720
FFMPEG_PRESET=veryfast
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
TEMP_UPLOAD_PATH=/tmp/uploads/temp
HLS_OUTPUT_PATH=/tmp/uploads/hls
STREAM_BASE_URL=https://your-backend.onrender.com

# Video storage. Render's free disk is erased on every restart, so use an S3-compatible bucket
# (Cloudflare R2 or Backblaze B2). Use `node scripts/storage-check.js` to test the values first.
STORAGE_DRIVER=s3
# R2:  https://<account-id>.r2.cloudflarestorage.com   (region: auto)
# B2:  https://s3.<region>.backblazeb2.com             (region: e.g. us-west-004)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=streamlearn-videos
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION=auto
# redirect = players download segments straight from the bucket (default); proxy = through this server
S3_SEGMENT_MODE=redirect
S3_PRESIGN_SECONDS=300

PLATFORM_NAME=StreamLearn
BRAND_COLOR=#e50914
