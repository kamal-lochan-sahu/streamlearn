# Copy this as .env on Render and fill in values

NODE_ENV=production
PORT=10000

# Replace with your actual production URLs
CLIENT_URL=https://your-app.vercel.app
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/streamlearn
JWT_SECRET=use_a_very_long_random_string_minimum_64_chars
REFRESH_TOKEN_SECRET=another_very_long_random_string_for_refresh
REDIS_URL=rediss://default:password@host.upstash.io:6380

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

FFMPEG_PATH=/usr/bin/ffmpeg
TEMP_UPLOAD_PATH=/tmp/uploads/temp
HLS_OUTPUT_PATH=/tmp/uploads/hls
STREAM_BASE_URL=https://your-backend.onrender.com

PLATFORM_NAME=StreamLearn
BRAND_COLOR=#e50914
